# Copy this file to .env and adjust the values for local development.
# Flask does not load .env automatically unless python-dotenv is installed;
# export these variables in your shell instead (see README.md).

# Secret used to sign JWT access tokens. MUST be changed in any real deployment.
JWT_SECRET=replace-with-a-long-random-string

# Token lifetime in seconds.
JWT_EXPIRES_SECONDS=3600

# SQLAlchemy database URL. Defaults to instance/app.db when unset.
# DATABASE_URL=sqlite:///app.db

# Set to "production" to make the application refuse to start without JWT_SECRET.
APP_ENV=development

# Password used by the `flask --app run seed-demo` command.
DEMO_PASSWORD=AliceDemo123!
