--- Dockerfile (vulnerable, equivalent to vulhub/supervisor:3.3.2)
+++ Dockerfile (fixed)
@@
-FROM python:2.7-slim
-RUN pip install --no-cache-dir supervisor==3.3.2
+FROM python:2.7-slim
+RUN pip install --no-cache-dir supervisor==3.3.3
@@
 # Supervisor 3.3.3 contains the upstream fix for CVE-2017-11610:
 # XML-RPC method resolution is limited to one namespace and one method,
 # and the result must be a bound method, so object traversal such as
 # supervisor.supervisord.options.warnings.linecache.os.system is rejected.
